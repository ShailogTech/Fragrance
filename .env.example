# Copy this file to .env on the target server and fill in the values.

# Required: MongoDB Atlas (or any MongoDB) connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Optional overrides (defaults shown):
# MONGODB_DB=shrifragrance
# FIREBASE_API_KEY=<public Firebase web key — already defaulted in code>
# PORT=3000

# Notes:
# - Shiprocket and SMTP credentials are NOT set here — enter them in the app:
#   Admin → Settings → Delivery Partner / Email & Notifications (stored in MongoDB).
# - Never commit a real .env to git.
