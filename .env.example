# Copy this file to .env on the target server and fill in the values.

# Required: MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017

# Required: HMAC secret for session tokens (HS256). Rotating it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=<64+ hex chars>

# Required: the address that runs the store (comma separated for more than one).
# Admin rights are tied to it. Create or reset the account with:
#   node scripts/seed-admin.mjs
ADMIN_EMAILS=<you@yourdomain>

# Optional overrides (defaults shown):
# MONGODB_DB=shrifragrance
# PORT=3000
